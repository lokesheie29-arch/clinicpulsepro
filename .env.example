# ====================================================================
# ClinicPulse Pro — Environment Template
# Copy this file to .env and configure your production / sandbox keys
# ====================================================================

# --------------------------------------------------------------------
# 1. RAZORPAY PAYMENT GATEWAY (CLIENT & SERVER)
# Get from: Razorpay Dashboard -> Account & Settings -> API Keys
# --------------------------------------------------------------------
# Client-side Public Key ID (Used to open checkout modal)
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

# Server-side Secret Keys (Vercel Serverless Functions / Node.js backend)
# CRITICAL: NEVER prefix with VITE_ to prevent leaking into client bundle!
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# --------------------------------------------------------------------
# 2. SUPABASE DATABASE & REALTIME
# Find in Supabase Dashboard -> Project Settings -> API
# --------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here (Server-side only)

# --------------------------------------------------------------------
# 3. CLERK AUTHENTICATION (STAFF & DOCTOR PORTAL)
# Find in Clerk Dashboard -> API Keys
# --------------------------------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# --------------------------------------------------------------------
# 4. APP METADATA
# --------------------------------------------------------------------
VITE_APP_NAME="ClinicPulse Pro"
VITE_APP_URL="https://clinicpulsepro.com"
