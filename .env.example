# ====================================================================
# ClinicPulse Pro — Environment Template
# Copy this file to .env and fill in your actual API keys
# ====================================================================

# --------------------------------------------------------------------
# 1. RAZORPAY PAYMENT GATEWAY (SUBSCRIPTIONS & CHECKOUT)
# Get from: Razorpay Dashboard -> Settings -> API Keys
# --------------------------------------------------------------------
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_here

# --------------------------------------------------------------------
# 2. SUPABASE DATABASE & AUTHENTICATION
# Find in Supabase Dashboard -> Project Settings -> API
# --------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --------------------------------------------------------------------
# 3. CLERK AUTHENTICATION (PATIENT & CLINIC LOGIN)
# Find in Clerk Dashboard -> API Keys
# --------------------------------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# --------------------------------------------------------------------
# 4. APP METADATA
# --------------------------------------------------------------------
VITE_APP_NAME="ClinicPulse Pro"
VITE_APP_URL="https://clinicpulsepro.com"
